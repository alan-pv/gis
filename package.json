{
  "name": "gis",
  "private": true,
  "version": "1.0.0",
  "description": "Gis: a smart blackboard that writes and draws while a teacher talks. Local, free and open source.",
  "license": "MIT",
  "repository": "github:alan-pv/gis",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "bash scripts/start.sh",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_GIS_DEMO=1 vite build --base ./",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sidecar:fake": "python3 sidecar/server.py --fake"
  },
  "dependencies": {
    "@fontsource/kalam": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-menubar": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "konva": "^10.3.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.5",
    "roughjs": "^4.6.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
